# Copy this file to .env and fill in values. Never commit .env.
# Leave the watsonx values empty to use the offline fallback.
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# Local emergency number shown in the emergency message (e.g. 999 for UK, 911 for US)
# Leave blank to use the clearly-marked demo default: [DEMO-999]
EMERGENCY_NUMBER=

# Region label shown alongside the emergency number in escalation messages (e.g. "UK")
# Leave blank to use the demo default: DEMO REGION
EMERGENCY_REGION=
