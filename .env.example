# Copy this file to .env and fill in values. Never commit .env.
# Leave the watsonx values empty to use the offline fallback.
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# Emergency number for the US region profile.
# Shown verbatim in the emergency message and button label.
# Must be 3–6 digits only (e.g. 911, 999, 112).
EMERGENCY_NUMBER=911

# Region label shown alongside the emergency number in escalation messages.
EMERGENCY_REGION=US

# Data source: hospitals_us (default, uses data/hospitals_clean.csv)
# or demo (uses data/services.json — keeps old synthetic tests working).
# Any other value is rejected at startup.
DATA_SOURCE=hospitals_us

# Audit log privacy setting.
# When false (default), raw user text is NEVER written to the log.
# The log records message length and a short hash instead.
# Set to true only in development/walkthrough environments where full text
# logging is needed for debugging and you have appropriate consent.
LOG_USER_TEXT=false
